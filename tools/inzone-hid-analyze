#!/usr/bin/env python3
"""Summarize a capture made with tools/inzone-hid-capture; offline, read-only.

Reads capture logs (lines like
``2026-10-15T18:00:00.123  id=  2  len= 64  02 14 04 ...``) and prints, per
report id, how many reports were seen and which bytes ever changed, then the
timeline of changes. With --find it also lists every occurrence of a byte
pattern (for example ``14 04``) with the byte that follows it, which is how
the battery hypothesis in docs/hardware.md can be checked against a long
passive capture.

Usage:
    tools/inzone-hid-analyze CAPTURE.log [...] [--find "14 04"] [--max-changes N]

Analysis only: it proves nothing about what a byte means. Treat results as
hypotheses until reproduced and cross-checked on hardware.
"""

from __future__ import annotations

import argparse
import re
import sys
from collections import defaultdict
from pathlib import Path

LINE = re.compile(
    r"^(?P<ts>\S+)\s+id=\s*(?P<id>\d+)\s+len=\s*(?P<len>\d+)\s+(?P<hex>(?:[0-9a-fA-F]{2}\s*)+)$"
)


def parse_lines(lines):
    """Yield (timestamp, report_id, bytes); skip lines that are not reports."""
    for raw in lines:
        match = LINE.match(raw.strip())
        if not match:
            continue
        data = bytes.fromhex(match["hex"].replace(" ", ""))
        if len(data) != int(match["len"]) or data[0] != int(match["id"]):
            continue
        yield match["ts"], int(match["id"]), data


def parse_pattern(text: str) -> bytes:
    try:
        return bytes.fromhex(text.replace(" ", ""))
    except ValueError:
        raise argparse.ArgumentTypeError(f"not a hex byte pattern: {text!r}") from None


def find_pattern(data: bytes, pattern: bytes):
    """Yield (offset, following_byte_or_None) for each occurrence."""
    start = 0
    while (index := data.find(pattern, start)) != -1:
        end = index + len(pattern)
        yield index, (data[end] if end < len(data) else None)
        start = index + 1


def analyze(records, pattern: bytes | None = None):
    counts: dict[int, int] = defaultdict(int)
    changed_offsets: dict[int, set[int]] = defaultdict(set)
    last: dict[int, bytes] = {}
    changes: list[tuple[str, int, list[tuple[int, int, int]]]] = []
    hits: list[tuple[str, int, int, int | None]] = []

    for timestamp, report_id, data in records:
        counts[report_id] += 1
        previous = last.get(report_id)
        if previous is not None and previous != data:
            diff = [
                (offset, old, new)
                for offset, (old, new) in enumerate(zip(previous, data, strict=False))
                if old != new
            ]
            if len(previous) != len(data):
                diff.append((min(len(previous), len(data)), -1, -1))
            changed_offsets[report_id].update(offset for offset, _, _ in diff)
            changes.append((timestamp, report_id, diff))
        last[report_id] = data
        if pattern:
            for offset, following in find_pattern(data, pattern):
                hits.append((timestamp, report_id, offset, following))
    return counts, changed_offsets, changes, hits


def render(counts, changed_offsets, changes, hits, max_changes: int) -> str:
    out = ["Reports per id:"]
    for report_id in sorted(counts):
        offsets = sorted(changed_offsets.get(report_id, ()))
        changed = ", ".join(map(str, offsets)) if offsets else "none"
        out.append(f"  id={report_id:3d}  count={counts[report_id]:6d}  changed offsets: {changed}")
    out.append(f"\nChanges ({len(changes)} total, showing up to {max_changes}):")
    for timestamp, report_id, diff in changes[:max_changes]:
        detail = " ".join(
            f"[{offset}] {old:02x}->{new:02x}" if old >= 0 else f"[{offset}] length"
            for offset, old, new in diff
        )
        out.append(f"  {timestamp}  id={report_id:3d}  {detail}")
    if hits:
        out.append(f"\nPattern hits ({len(hits)}):")
        for timestamp, report_id, offset, following in hits:
            value = "end" if following is None else f"{following:02x}"
            out.append(f"  {timestamp}  id={report_id:3d}  offset={offset}  next={value}")
    return "\n".join(out)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("captures", nargs="+", type=Path)
    parser.add_argument("--find", type=parse_pattern, default=None, help='hex bytes, e.g. "14 04"')
    parser.add_argument("--max-changes", type=int, default=200)
    arguments = parser.parse_args()

    records = []
    for path in arguments.captures:
        try:
            with path.open(encoding="utf-8") as source:
                records.extend(parse_lines(source))
        except OSError as error:
            print(f"inzone-hid-analyze: {error}", file=sys.stderr)
            return 1
    if not records:
        print("inzone-hid-analyze: no HID reports found in the input", file=sys.stderr)
        return 1
    records.sort(key=lambda record: record[0])
    print(render(*analyze(records, arguments.find), arguments.max_changes))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
