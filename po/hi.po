"Content-Transfer-Encoding: 8bit\n"

msgid "Refresh device status"
msgstr "डिवाइस की स्थिति ताज़ा करें"

msgid "Quit"
msgstr "बाहर निकलें"

msgid "Game / Chat audio"
msgstr "गेम / चैट ऑडियो"

msgid "Checking for the PC-mode dongle…"
msgstr "पीसी मोड में डोंगल खोजा जा रहा है…"

msgid "Overall volume"
msgstr "कुल वॉल्यूम"

msgid "Limits the louder Game/Chat endpoint. At center, both use this volume."
msgstr ""
"गेम/चैट में जो ज़्यादा तेज़ है उसे सीमित करता है। बीच में दोनों इसी वॉल्यूम का उपयोग करते हैं।"

msgid "Center"
msgstr "बीच में लाएँ"

msgid "Set Game and Chat to the same volume (balance 50)"
msgstr "गेम और चैट को समान वॉल्यूम पर सेट करें (संतुलन 50)"

msgid "Boost Chat"
msgstr "चैट बढ़ाएँ"

msgid ""
"Set Chat to 70% and Game to 30%; press again to restore the volumes from "
"before"
msgstr "चैट को 70% और गेम को 30% पर सेट करता है; पहले के वॉल्यूम लौटाने के लिए फिर दबाएँ"

msgid "Game / Chat balance"
msgstr "गेम / चैट संतुलन"

msgid "0 = Chat, 50 = both equally, 100 = Game"
msgstr "0 = चैट, 50 = दोनों बराबर, 100 = गेम"

msgid "Chat"
msgstr "चैट"

msgid "Both"
msgstr "दोनों"

msgid "Game"
msgstr "गेम"

msgid "Microphone volume"
msgstr "माइक्रोफ़ोन वॉल्यूम"

msgid "Input level sent to voice applications."
msgstr "वॉइस एप्लिकेशन को भेजा जाने वाला इनपुट स्तर।"

msgid "Use Game output + INZONE microphone"
msgstr "गेम आउटपुट + INZONE माइक्रोफ़ोन उपयोग करें"

msgid "Start at login in the tray"
msgstr "लॉगिन पर ट्रे में शुरू करें"

msgid "Tray integration: checking…"
msgstr "ट्रे एकीकरण: जाँच हो रही है…"

msgid "Tray integration active — closing hides this window."
msgstr "ट्रे एकीकरण सक्रिय — बंद करने पर यह विंडो छिप जाती है।"

msgid "Tray icon unavailable — install/enable AppIndicator support in GNOME."
msgstr "ट्रे आइकन उपलब्ध नहीं — GNOME में AppIndicator समर्थन इंस्टॉल/सक्षम करें।"

#, python-brace-format
msgid "Audio control error: {message}"
msgstr "ऑडियो नियंत्रण त्रुटि: {message}"

msgid "● INZONE Buds connected in PC mode"
msgstr "● INZONE Buds पीसी मोड में कनेक्ट हैं"

msgid ""
"INZONE Buds PC-mode endpoints are unavailable. Connect the dongle with its "
"switch set to PC."
msgstr ""
"INZONE Buds के पीसी मोड एंडपॉइंट उपलब्ध नहीं हैं। डोंगल को उसके स्विच को PC पर रखकर "
"कनेक्ट करें।"

msgid "another device"
msgstr "अन्य डिवाइस"

msgid "INZONE microphone"
msgstr "INZONE माइक्रोफ़ोन"

#, python-brace-format
msgid ""
"Game {game}%  ·  Chat {chat}%  ·  Default output: {output}  ·  Default "
"input: {input}"
msgstr ""
"गेम {game}%  ·  चैट {chat}%  ·  डिफ़ॉल्ट आउटपुट: {output}  ·  डिफ़ॉल्ट इनपुट: {input}"

#, python-brace-format
msgid "could not change the login setting: {error}"
msgstr "लॉगिन सेटिंग नहीं बदली जा सकी: {error}"

msgid "Show Window"
msgstr "विंडो दिखाएँ"

msgid "Center Game/Chat"
msgstr "गेम/चैट बीच में लाएँ"

msgid "Boost Chat 70%"
msgstr "चैट बढ़ाएँ 70%"

msgid "INZONE Buds connected"
msgstr "INZONE Buds कनेक्ट हुए"

msgid "Game and Chat are ready."
msgstr "गेम और चैट तैयार हैं।"

msgid "INZONE Buds disconnected"
msgstr "INZONE Buds डिस्कनेक्ट हुए"

msgid "INZONE Buds Mixer"
msgstr "INZONE Buds Mixer"

msgid "Control Game, Chat and microphone levels for INZONE Buds"
msgstr "INZONE Buds के गेम, चैट और माइक्रोफ़ोन स्तर नियंत्रित करें"

msgid "INZONE;Buds;Game;Chat;Audio;Mixer;"
msgstr "INZONE;Buds;गेम;चैट;ऑडियो;मिक्सर;"

msgid "Control the native Game, Chat and microphone endpoints on Linux"
msgstr "Linux पर मूल गेम, चैट और माइक्रोफ़ोन एंडपॉइंट नियंत्रित करें"

msgid ""
"INZONE Buds Mixer is an unofficial open-source controller for the Sony "
"INZONE Buds USB dongle in PC mode. It adjusts the native Game and Chat "
"balance, overall playback level and microphone level through PipeWire."
msgstr ""
"INZONE Buds Mixer, पीसी मोड में Sony INZONE Buds USB डोंगल के लिए एक अनौपचारिक "
"ओपन-सोर्स कंट्रोलर है। यह PipeWire के माध्यम से मूल गेम और चैट संतुलन, कुल प्लेबैक स्तर और "
"माइक्रोफ़ोन स्तर समायोजित करता है।"

msgid ""
"This project is not affiliated with or endorsed by Sony. INZONE and Sony are "
"trademarks of their respective owner."
msgstr ""
"यह प्रोजेक्ट Sony से संबद्ध नहीं है और न ही उसके द्वारा समर्थित है। INZONE और Sony अपने-"
"अपने स्वामियों के ट्रेडमार्क हैं।"
