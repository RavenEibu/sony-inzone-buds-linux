msgid "Refresh device status"
msgstr "Обновить состояние устройства"

msgid "Quit"
msgstr "Выход"

msgid "Game / Chat audio"
msgstr "Звук «Игра» / «Чат»"

msgid "Checking for the PC-mode dongle…"
msgstr "Поиск адаптера в режиме ПК…"

msgid "Overall volume"
msgstr "Общая громкость"

msgid "Limits the louder Game/Chat endpoint. At center, both use this volume."
msgstr ""
"Ограничивает более громкий канал «Игра»/«Чат». В центре оба используют эту "
"громкость."

msgid "Center"
msgstr "По центру"

msgid "Set Game and Chat to the same volume (balance 50)"
msgstr "Установить одинаковую громкость «Игры» и «Чата» (баланс 50)"

msgid "Boost Chat"
msgstr "Усилить чат"

msgid ""
"Set Chat to 70% and Game to 30%; press again to restore the volumes from "
"before"
msgstr ""
"Устанавливает «Чат» на 70 % и «Игру» на 30 %; нажмите ещё раз, чтобы вернуть "
"прежнюю громкость"

msgid "Game / Chat balance"
msgstr "Баланс «Игра» / «Чат»"

msgid "0 = Chat, 50 = both equally, 100 = Game"
msgstr "0 = Чат, 50 = поровну, 100 = Игра"

msgid "Chat"
msgstr "Чат"

msgid "Both"
msgstr "Оба"

msgid "Game"
msgstr "Игра"

msgid "Microphone volume"
msgstr "Громкость микрофона"

msgid "Input level sent to voice applications."
msgstr "Уровень входного сигнала для голосовых приложений."

msgid "Use Game output + INZONE microphone"
msgstr "Использовать вывод «Игра» + микрофон INZONE"

msgid "Start at login in the tray"
msgstr "Запускать при входе в систему в трее"

msgid "Tray integration: checking…"
msgstr "Интеграция с треем: проверка…"

msgid "Tray integration active — closing hides this window."
msgstr "Интеграция с треем активна — закрытие скрывает это окно."

msgid "Tray icon unavailable — install/enable AppIndicator support in GNOME."
msgstr ""
"Значок в трее недоступен — установите или включите поддержку AppIndicator в "
"GNOME."

#, python-brace-format
msgid "Audio control error: {message}"
msgstr "Ошибка управления звуком: {message}"

msgid "● INZONE Buds connected in PC mode"
msgstr "● INZONE Buds подключены в режиме ПК"

msgid ""
"INZONE Buds PC-mode endpoints are unavailable. Connect the dongle with its "
"switch set to PC."
msgstr ""
"Конечные точки режима ПК для INZONE Buds недоступны. Подключите адаптер, "
"переведя переключатель в положение PC."

msgid "another device"
msgstr "другое устройство"

msgid "INZONE microphone"
msgstr "микрофон INZONE"

#, python-brace-format
msgid ""
"Game {game}%  ·  Chat {chat}%  ·  Default output: {output}  ·  Default "
"input: {input}"
msgstr ""
"Игра {game} %  ·  Чат {chat} %  ·  Вывод по умолчанию: {output}  ·  Ввод по "
"умолчанию: {input}"

#, python-brace-format
msgid "could not change the login setting: {error}"
msgstr "не удалось изменить настройку запуска при входе: {error}"

msgid "Show Window"
msgstr "Показать окно"

msgid "Center Game/Chat"
msgstr "Центрировать «Игру»/«Чат»"

msgid "Boost Chat 70%"
msgstr "Усилить чат 70 %"

msgid "INZONE Buds connected"
msgstr "INZONE Buds подключены"

msgid "Game and Chat are ready."
msgstr "«Игра» и «Чат» готовы."

msgid "INZONE Buds disconnected"
msgstr "INZONE Buds отключены"
