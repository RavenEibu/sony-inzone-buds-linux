msgid "Refresh device status"
msgstr "Actualizar el estado del dispositivo"

msgid "Quit"
msgstr "Salir"

msgid "Game / Chat audio"
msgstr "Audio Juego / Chat"

msgid "Checking for the PC-mode dongle…"
msgstr "Buscando el dongle en modo PC…"

msgid "Overall volume"
msgstr "Volumen general"

msgid "Limits the louder Game/Chat endpoint. At center, both use this volume."
msgstr ""
"Limita el extremo más alto entre Juego y Chat. En el centro, ambos usan este "
"volumen."

msgid "Center"
msgstr "Centrar"

msgid "Set Game and Chat to the same volume (balance 50)"
msgstr "Poner Juego y Chat al mismo volumen (balance 50)"

msgid "Boost Chat"
msgstr "Potenciar Chat"

msgid ""
"Set Chat to 70% and Game to 30%; press again to restore the volumes from "
"before"
msgstr ""
"Pone Chat al 70 % y Juego al 30 %; púlsalo de nuevo para restaurar los "
"volúmenes anteriores"

msgid "Game / Chat balance"
msgstr "Balance Juego / Chat"

msgid "0 = Chat, 50 = both equally, 100 = Game"
msgstr "0 = Chat, 50 = ambos por igual, 100 = Juego"

msgid "Chat"
msgstr "Chat"

msgid "Both"
msgstr "Ambos"

msgid "Game"
msgstr "Juego"

msgid "Microphone volume"
msgstr "Volumen del micrófono"

msgid "Input level sent to voice applications."
msgstr "Nivel de entrada enviado a las aplicaciones de voz."

msgid "Use Game output + INZONE microphone"
msgstr "Usar salida Juego + micrófono INZONE"

msgid "Start at login in the tray"
msgstr "Iniciar al abrir sesión en la bandeja"

msgid "Tray integration: checking…"
msgstr "Integración con la bandeja: comprobando…"

msgid "Tray integration active — closing hides this window."
msgstr "Integración con la bandeja activa: al cerrar se oculta esta ventana."

msgid "Tray icon unavailable — install/enable AppIndicator support in GNOME."
msgstr ""
"Icono de bandeja no disponible: instala o activa la compatibilidad con "
"AppIndicator en GNOME."

#, python-brace-format
msgid "Audio control error: {message}"
msgstr "Error del control de audio: {message}"

msgid "● INZONE Buds connected in PC mode"
msgstr "● INZONE Buds conectados en modo PC"

msgid ""
"INZONE Buds PC-mode endpoints are unavailable. Connect the dongle with its "
"switch set to PC."
msgstr ""
"Los extremos en modo PC de INZONE Buds no están disponibles. Conecta el "
"dongle con su interruptor en PC."

msgid "another device"
msgstr "otro dispositivo"

msgid "INZONE microphone"
msgstr "micrófono INZONE"

#, python-brace-format
msgid ""
"Game {game}%  ·  Chat {chat}%  ·  Default output: {output}  ·  Default "
"input: {input}"
msgstr ""
"Juego {game} %  ·  Chat {chat} %  ·  Salida predeterminada: {output}  ·  "
"Entrada predeterminada: {input}"

#, python-brace-format
msgid "could not change the login setting: {error}"
msgstr "no se pudo cambiar el ajuste de inicio de sesión: {error}"

msgid "Show Window"
msgstr "Mostrar ventana"

msgid "Center Game/Chat"
msgstr "Centrar Juego/Chat"

msgid "Boost Chat 70%"
msgstr "Potenciar Chat 70 %"

msgid "INZONE Buds connected"
msgstr "INZONE Buds conectados"

msgid "Game and Chat are ready."
msgstr "Juego y Chat están listos."

msgid "INZONE Buds disconnected"
msgstr "INZONE Buds desconectados"
