msgid ""
msgstr ""
"Project-Id-Version: inzone-buds-mixer\n"
"Report-Msgid-Bugs-To: https://github.com/RavenEibu/sony-inzone-buds-linux/"
"issues\n"
"POT-Creation-Date: 2026-10-15 19:28-0300\n"
"PO-Revision-Date: 2026-10-15 00:00+0000\n"
"Last-Translator: Claude (draft, needs native review)\n"
"Language-Team: Portuguese (Brazilian wording)\n"
"Language: pt\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Refresh device status"
msgstr "Atualizar o estado do dispositivo"

msgid "Quit"
msgstr "Sair"

msgid "Game / Chat audio"
msgstr "Áudio Jogo / Chat"

msgid "Checking for the PC-mode dongle…"
msgstr "Procurando o dongle no modo PC…"

msgid "Overall volume"
msgstr "Volume geral"

msgid "Limits the louder Game/Chat endpoint. At center, both use this volume."
msgstr ""
"Limita o canal mais alto entre Jogo e Chat. No centro, ambos usam este "
"volume."

msgid "Center"
msgstr "Centralizar"

msgid "Set Game and Chat to the same volume (balance 50)"
msgstr "Colocar Jogo e Chat no mesmo volume (balanço 50)"

msgid "Boost Chat"
msgstr "Reforçar Chat"

msgid ""
"Set Chat to 70% and Game to 30%; press again to restore the volumes from "
"before"
msgstr ""
"Coloca o Chat em 70% e o Jogo em 30%; pressione de novo para restaurar os "
"volumes anteriores"

msgid "Game / Chat balance"
msgstr "Balanço Jogo / Chat"

msgid "0 = Chat, 50 = both equally, 100 = Game"
msgstr "0 = Chat, 50 = ambos igualmente, 100 = Jogo"

msgid "Chat"
msgstr "Chat"

msgid "Both"
msgstr "Ambos"

msgid "Game"
msgstr "Jogo"

msgid "Microphone volume"
msgstr "Volume do microfone"

msgid "Input level sent to voice applications."
msgstr "Nível de entrada enviado aos aplicativos de voz."

msgid "Use Game output + INZONE microphone"
msgstr "Usar saída Jogo + microfone INZONE"

msgid "Start at login in the tray"
msgstr "Iniciar ao entrar na sessão na bandeja"

msgid "Tray integration: checking…"
msgstr "Integração com a bandeja: verificando…"

msgid "Tray integration active — closing hides this window."
msgstr "Integração com a bandeja ativa: fechar oculta esta janela."

msgid "Tray icon unavailable — install/enable AppIndicator support in GNOME."
msgstr ""
"Ícone da bandeja indisponível: instale ou ative o suporte a AppIndicator no "
"GNOME."

#, python-brace-format
msgid "Audio control error: {message}"
msgstr "Erro no controle de áudio: {message}"

msgid "● INZONE Buds connected in PC mode"
msgstr "● INZONE Buds conectados no modo PC"

msgid ""
"INZONE Buds PC-mode endpoints are unavailable. Connect the dongle with its "
"switch set to PC."
msgstr ""
"Os endpoints do modo PC do INZONE Buds estão indisponíveis. Conecte o dongle "
"com a chave em PC."

msgid "another device"
msgstr "outro dispositivo"

msgid "INZONE microphone"
msgstr "microfone INZONE"

#, python-brace-format
msgid ""
"Game {game}%  ·  Chat {chat}%  ·  Default output: {output}  ·  Default "
"input: {input}"
msgstr ""
"Jogo {game}%  ·  Chat {chat}%  ·  Saída padrão: {output}  ·  Entrada padrão: "
"{input}"

#, python-brace-format
msgid "could not change the login setting: {error}"
msgstr "não foi possível alterar a configuração de início de sessão: {error}"

msgid "Show Window"
msgstr "Mostrar janela"

msgid "Center Game/Chat"
msgstr "Centralizar Jogo/Chat"

msgid "Boost Chat 70%"
msgstr "Reforçar Chat 70%"

msgid "INZONE Buds connected"
msgstr "INZONE Buds conectados"

msgid "Game and Chat are ready."
msgstr "Jogo e Chat estão prontos."

msgid "INZONE Buds disconnected"
msgstr "INZONE Buds desconectados"
