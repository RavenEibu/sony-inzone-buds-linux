#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
DATA_HOME=${XDG_DATA_HOME:-"$HOME/.local/share"}

candidates=(
  "${INZONE_BUDS_MIXER_DATADIR:-}"
  "$DATA_HOME/inzone-buds-mixer"
  "$SCRIPT_DIR/../share/inzone-buds-mixer"
  "$SCRIPT_DIR/../src/inzone_buds_mixer"
  "/usr/share/inzone-buds-mixer"
)

found=''
for app_dir in "${candidates[@]}"; do
  if [[ -n $app_dir && -f $app_dir/app.py ]]; then
    found=$app_dir
    break
  fi
done

if [[ -z $found ]]; then
  printf 'inzone-buds-mixer: application files were not found\n' >&2
  exit 1
fi

export INZONE_BUDS_MIXER_DATADIR=$found
# The launch-at-login entry needs an absolute command: the session may start it
# before ~/.local/bin is in PATH.
export INZONE_BUDS_MIXER_COMMAND="$SCRIPT_DIR/${BASH_SOURCE[0]##*/}"
exec python3 "$found/app.py" "$@"
